{
  "name": "spolierblock",
  "version": "0.2.1",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "Blocks spoilers about unseen movies, shows, games and books, fully offline.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/run.mjs",
    "build": "node tools/build.mjs",
    "build:fixture": "node tools/build.mjs test/fixtures/catalog.small.json",
    "lint": "web-ext lint --source-dir dist/firefox",
    "start": "web-ext run --source-dir dist/firefox --firefox=/usr/bin/zen-browser"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.7.5",
    "onnxruntime-web": "^1.22.0",
    "puppeteer-core": "^25.18.1",
    "web-ext": "^10.8.0"
  }
}
