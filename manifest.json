{
  "manifest_version": 3,
  "name": "SpolierBlock",
  "version": "0.2.0",
  "description": "Blacks out spoilers about movies, shows, games and books you have not seen. Runs fully offline.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spolierblock@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/matcher.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["data/index.bin", "data/index.json", "data/catalog-info.json"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "SpolierBlock",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-blocking": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Turn blocking on or off"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
